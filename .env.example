# ==============================================================================
# Jan Sahayak (जनसहायक) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and populate the secrets.
# NEVER commit .env or .env.local to version control.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed origins for CORS. In production, set to your domain.
ALLOWED_ORIGINS=http://localhost:3737,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3737

# Flag to govern whether the platform operates with mock data fallback or enforces DB.
# Set DEMO_MODE=true for isolated demos without external DB.
# Set DEMO_MODE=false for production mode.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. Database — PostgreSQL with PostGIS and pgvector
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection URI (e.g., Supabase, Neon, AWS RDS, or local PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=
# Alternative variables accepted by connection pool:
# POSTGRES_URL=
# PG_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# 3. Supabase Configuration (Authentication, Storage, Realtime)
# ------------------------------------------------------------------------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=
# Public anon key (safe for client, restricted by RLS)
SUPABASE_ANON_KEY=
# Service role key (used strictly server-side for administrative tasks)
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Vite environment variables (must start with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 4. AI Engine Configuration (Google Gemini & Embeddings)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Complaint Analysis, DNA generation, and embeddings
GEMINI_API_KEY=
# Alternative variable alias:
# AI_API_KEY=
# Model to use (default: gemini-1.5-flash or gemini-2.0-flash)
AI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. Security & Rate Limiting
# ------------------------------------------------------------------------------
# Window for rate limiter in milliseconds (e.g., 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
# Max requests per IP within the window
RATE_LIMIT_MAX_REQUESTS=120
