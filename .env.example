# JanSahayk (जनसहायक) — Environment Configuration Template

# Server Port
PORT=3001
NODE_ENV=development

# Frontend Vite API Proxy / Target
VITE_API_BASE_URL=http://localhost:3001

# AI Orchestration Provider: 'local_indic_bert' | 'gemini' | 'openai' | 'mock'
AI_PROVIDER=local_indic_bert
AI_API_KEY=your_ai_api_key_here

# Database Configuration (In-Memory persistent store by default, supports PostgreSQL / SQLite)
DATABASE_URL=sqlite://./jansahayk.db

# Authentication Secret
AUTH_SECRET=jansahayk_municipal_jwt_secret_token_2026

# Municipal GIS Map Engine Key (Optional)
MAP_API_KEY=your_bhuvan_or_mapbox_key_here
